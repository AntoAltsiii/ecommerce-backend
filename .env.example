# ===============================================
# PLANTILLA DE VARIABLES DE ENTORNO
# ===============================================
# Copia este archivo como .env y reemplaza los valores

# Credenciales de PostgreSQL (para Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=postgres

# Credenciales de Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_password_here

# Base de datos de Keycloak
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_KEYCLOAK_USER=keycloak
POSTGRES_KEYCLOAK_PASSWORD=your_password_here

# Credenciales para microservicios (usadas en application.yml)
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=postgres
DB_PORT=5432
